{
  "name": "docamatic",
  "version": "5.0.0",
  "private": true,
  "description": "A simple tool for you to add sticky notes to any webpage",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@sentry/browser": "7.120.4",
    "dompurify": "3.4.17",
    "fuse.js": "7.1.0",
    "react": "18.3.1",
    "react-contenteditable": "3.3.7",
    "react-dom": "18.3.1",
    "react-redux": "8.0.4",
    "react-rnd": "10.5.3",
    "redux": "4.2.1",
    "webext-redux": "4.0.0"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.6",
    "@types/chrome": "0.3.5",
    "@types/node": "^22.18.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
